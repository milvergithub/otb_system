# Database
# For npm (local): use localhost — docker-compose.yml overrides to host.docker.internal automatically
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=otb_system

# Server
PORT=3001
NODE_ENV=development
# Max JSON body size (base64 images for meter readings)
BODY_LIMIT=10mb
# Exact origin of the frontend (scheme + host + port, no trailing slash).
# * = reflect any origin (any website can call the API with credentials).
# Comma-separated list for whitelist, e.g. http://localhost:5173,http://other:8080
CORS_ORIGIN=*

# Logging (winston). Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Audit Log
# Set to a number of days to enable automatic cleanup (e.g. 90). Use 0 to keep logs forever.
AUDIT_LOG_RETENTION_DAYS=0

# OpenWA (WhatsApp notifications when a bill is generated)
# Set enabled to true to send WhatsApp messages; set to false to disable
OPENWA_ENABLED=false
OPENWA_BASE_URL=http://localhost:2785
OPENWA_SESSION_ID=
OPENWA_API_KEY=
# Template IDs (copy actual values from packages/server/.env)
OPENWA_CONSUMPTION_TEMPLATE_ID=
OPENWA_WELCOME_TEMPLATE_ID=
OPENWA_METER_REGISTERED_TEMPLATE_ID=
# Timeout in milliseconds for OpenWA HTTP calls
OPENWA_TIMEOUT_MS=10000

# Image storage (S3-compatible, e.g. RustFS). The DB stores object KEYS only;
# full URL = RUSTFS_PUBLIC_URL/bucket/key. Copy real values from packages/server/.env
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_BUCKET=otb-system
RUSTFS_PUBLIC_URL=http://localhost:9000

# Initial admin user (created automatically on first boot if it doesn't exist).
# Set strong values in production and change the password after first login.
SEED_ADMIN_EMAIL=admin@otb.com
SEED_ADMIN_PASSWORD=admin123
