# API base URL (baked into the frontend at build time)
# For local server: VITE_API_URL=http://localhost:3001/api
# For production:   VITE_API_URL=http://<your-server-ip>:3001/api
VITE_API_URL=http://localhost:3001/api

# PWA dev tools
VITE_PWA_DEV=false

# OSRM routing (meters "route" mode). Public demo, configurable.
# Foot profile (default): https://routing.openstreetmap.de/routed-foot
# Car profile:             https://routing.openstreetmap.de/routed-car
# OSRM demo:               https://router.project-osrm.org  (profile: driving)
# Public demo servers are rate-limited (≈1 req/s) and not guaranteed for production.
VITE_OSRM_URL=https://routing.openstreetmap.de/routed-foot
VITE_OSRM_PROFILE=foot
